# From the app's settings in the Shopify Dev Dashboard / Partner Dashboard
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must match access_scopes in shopify.app.toml
SCOPES=read_metaobjects,write_metaobjects
# Public URL of the deployed app (no trailing slash), e.g. https://faq-manager.up.railway.app
SHOPIFY_APP_URL=
